<Window x:Class="ClaudeLocalBridge.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Install Local Claude Bridge" Icon="Bridge.ico" Width="580" Height="380" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#141A24" Foreground="#F0F5F7" FontFamily="Segoe UI">
 <StackPanel Margin="30"><StackPanel Orientation="Horizontal"><Image Source="Bridge.ico" Width="64" Height="64" Margin="0,0,20,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Local Claude Bridge" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Windows installer" Foreground="#AAB7C5"/></StackPanel></StackPanel>
 <TextBlock Text="Install for your Windows account. Your Claude login, settings and API keys are preserved. No administrator access is required." TextWrapping="Wrap" Margin="0,25,0,12"/>
 <TextBlock x:Name="DestinationText" Foreground="#AAB7C5" TextWrapping="Wrap" FontSize="12"/>
 <TextBlock x:Name="Status" Text="Ready to install." TextWrapping="Wrap" Margin="0,20,0,15"/>
 <ProgressBar x:Name="Progress" Height="5" IsIndeterminate="True" Visibility="Hidden"/>
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button x:Name="InstallButton" Content="Install and open" Click="Install_Click" Padding="20,9" Margin="0,0,10,0"/><Button x:Name="CloseButton" Content="Close" Click="Close_Click" Padding="20,9"/></StackPanel>
 </StackPanel>
</Window>
